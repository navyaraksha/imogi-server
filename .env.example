DATABASE_URL=postgres://user:password@localhost:5432/imogi?sslmode=disable
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_HOSTED_DOMAIN=
GOOGLE_BOOTSTRAP_PLATFORM_ADMIN_EMAILS=admin@example.com
SENSITIVE_DATA_ENCRYPTION_KEY_BASE64=generate-a-32-byte-base64-key
SENSITIVE_DATA_LOOKUP_KEY_BASE64=generate-a-32-byte-base64-key
HTTP_ADDR=:8080
HTTP_ALLOWED_ORIGINS=http://localhost:5173
WEB_TEST_API_BASE_URL=http://localhost:8080
HTTP_SHUTDOWN_TIMEOUT=10s
SESSION_TTL=8h
SESSION_COOKIE_SECURE=false
DB_MAX_CONNS=10
DB_MIN_CONNS=1
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SECURE=false
OBJECT_STORAGE_PRESIGN_TTL=15m
# Alternatively, AWS_ENDPOINT_URL_S3, AWS_REGION, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, and AWS_S3_BUCKET are accepted automatically.
FILE_STORAGE_ROOT=.data/objects
FILE_MAX_UPLOAD_BYTES=104857600
FILE_MAX_ROWS=500000
JOB_WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL=2s
JOB_LEASE_DURATION=2m
JOB_HEARTBEAT_INTERVAL=30s
JOB_MAX_ATTEMPTS=5
JOB_SHUTDOWN_TIMEOUT=30s
